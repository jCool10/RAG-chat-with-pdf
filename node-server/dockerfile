# Stage 1: Build
FROM node:22-alpine AS build

WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Install dependencies
RUN yarn install --frozen-lockfile

# Copy source code
COPY . .

# Build TypeScript project
RUN yarn build

# Stage 2: Production
FROM node:22-alpine AS production

WORKDIR /app

# Copy package files for production dependencies
COPY package.json yarn.lock ./

# Install only production dependencies
RUN yarn install --frozen-lockfile --production && yarn cache clean

# Copy built application from build stage
COPY --from=build /app/dist ./dist

# Listen on the exposed port; NODE_ENV=production also hides error stacks and query logging
ENV NODE_ENV=production \
    PORT=3000

# logs: winston output. /shared/uploads: S3 downloads handed to python-server by path through a shared
# volume; world-writable with sticky bit so it works whichever container initialises the volume first
RUN mkdir -p logs /shared/uploads && chmod 1777 /shared/uploads

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Change ownership of app directory
RUN chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/healthCheck || exit 1

# Start the application
CMD ["node", "dist/index.js"]
