# Build BASE
FROM node:22-alpine AS base

WORKDIR /app
COPY package.json yarn.lock ./
RUN apk add --no-cache libc6-compat \
    && yarn --frozen-lockfile \
    && yarn cache clean

# Build stage
FROM node:22-alpine AS build

WORKDIR /app
COPY --from=base /app/node_modules ./node_modules
COPY . .
# Next inlines NEXT_PUBLIC_* into the browser bundle at build time, so the API URL must be a build arg.
# Format: node-server origin as seen from the browser, with a trailing slash and without /api.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN yarn build

# Production stage
FROM node:22-alpine AS production

WORKDIR /app

# Copy built application
COPY --from=build /app/public ./public
COPY --from=build /app/next.config.mjs ./
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

# Docker sets HOSTNAME to the container id; the standalone server must bind all interfaces instead
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

EXPOSE 3000

CMD ["node", "server.js"]
